def local_extrema(df: pd.DataFrame, window: int = 5) -> Tuple[List[int], List[int]]:
    """
    Находит локальные максимумы и минимумы по high/low.
    Args:
        df: DataFrame с колонками high/low.
        window: Размер окна для rolling max/min.
    Returns:
        Кортеж (список индексов максимумов, список индексов минимумов).
    """
    high_max = df['high'].rolling(window, center=True).max()
    low_min = df['low'].rolling(window, center=True).min()
    highs = df[df['high'] == high_max].index.tolist()
    lows = df[df['low'] == low_min].index.tolist()
    return highs, lows
def detect_flags(df: pd.DataFrame, lookback: int = 20, threshold: float = 0.005) -> List[Tuple]:
    """
    Обнаруживает флаги (бычий/медвежий).
    Args:
        df: DataFrame с ценами.
        lookback: Количество свечей для анализа.
        threshold: Минимальная волатильность для признания консолидации.
    Returns:
        Список кортежей (timestamp, название паттерна).
    """
    patterns = []
    for i in range(lookback, len(df)):
        seg = df['close'].iloc[i-lookback:i]
        diff = seg.max() - seg.min()
        if seg.min() <= 0:
            continue
        if diff / seg.min() < threshold:
            slope = (seg.iloc[-1] - seg.iloc[0]) / seg.iloc[0]
            if slope > 0.0:
                patterns.append((seg.index[-1], "Bullish Flag"))
            elif slope < 0.0:
                patterns.append((seg.index[-1], "Bearish Flag"))
    return patterns
def detect_triangles(df: pd.DataFrame, lookback: int = 24) -> List[Tuple]:
    """Обнаруживает треугольники (восходящий, нисходящий, симметричный)."""
    patterns = []
    for i in range(lookback, len(df)):
        seg = df.iloc[i-lookback:i]
        x = np.arange(len(seg))
        try:
            high_coef = np.polyfit(x, seg['high'].values, 1)[0]
            low_coef = np.polyfit(x, seg['low'].values, 1)[0]
        except Exception:
            continue
        if abs(high_coef) < 0.001 and low_coef > 0.0:
            patterns.append((seg.index[-1], "Ascending Triangle"))
        elif abs(low_coef) < 0.001 and high_coef < 0.0:
            patterns.append((seg.index[-1], "Descending Triangle"))
        elif high_coef < 0 and low_coef > 0:
            patterns.append((seg.index[-1], "Symmetrical Triangle"))
    return patterns
def detect_fvg(df: pd.DataFrame, gap_perc: float = 0.002) -> List[Tuple]:
    """
    Обнаруживает Fair Value Gap (FVG) — разрывы между свечами.
    Args:
        df: DataFrame.
        gap_perc: Минимальный размер гэпа в процентах.
    """
    patterns = []
    for i in range(2, len(df)):
        prev_high = df['high'].iloc[i-2]
        prev_low = df['low'].iloc[i-2]
        curr_open = df['open'].iloc[i]
        if curr_open > prev_high * (1 + gap_perc):
            patterns.append((df.index[i], "FVG Up"))
        elif curr_open < prev_low * (1 - gap_perc):
            patterns.append((df.index[i], "FVG Down"))
    return patterns
def detect_bos(df: pd.DataFrame, window: int = 5) -> List[Tuple]:
    """Обнаруживает Break of Structure (BOS) — пробой предыдущих экстремумов."""
    patterns = []
    highs, lows = local_extrema(df, window)
    for i in range(1, len(highs)):
        try:
            if df.loc[highs[i], 'high'] > df.loc[highs[i-1], 'high']:
                patterns.append((highs[i], "BOS Up"))
        except Exception:
            continue
    for i in range(1, len(lows)):
        try:
            if df.loc[lows[i], 'low'] < df.loc[lows[i-1], 'low']:
                patterns.append((lows[i], "BOS Down"))
        except Exception:
            continue
    return patterns
def detect_head_shoulders(df: pd.DataFrame, window: int = 5, threshold: float = 0.01) -> List[Tuple]:
    """Обнаруживает паттерн «Голова и плечи» (инверсный не реализован)."""
    patterns = []
    for i in range(window, len(df) - window):
        left_max = df['high'].iloc[i-window:i].max()
        head = df['high'].iloc[i]
        right_max = df['high'].iloc[i+1:i+1+window].max()
        if head > left_max * (1 + threshold) and head > right_max * (1 + threshold):
            patterns.append((df.index[i], "Head & Shoulders"))
    return patterns
def detect_all_patterns(df: pd.DataFrame) -> List[Tuple]:
    """
    Запускает все функции обнаружения паттернов и объединяет результаты.
    Returns:
        Список кортежей (timestamp, название паттерна).
    """
    all_patterns = []
    try:
        all_patterns += detect_flags(df)
        all_patterns += detect_triangles(df)
        all_patterns += detect_fvg(df)
        all_patterns += detect_bos(df)
        all_patterns += detect_head_shoulders(df)
    except Exception as e:
        log(f"Pattern detection error: {e}", "ERROR")
    return all_patterns
