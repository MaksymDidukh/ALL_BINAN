class TelegramReporter:
    """
    Класс для отправки уведомлений и отчётов в Telegram.
    Работает асинхронно, но имеет синхронный wrapper.
    """
    def __init__(self, token: str, chat_id: str):
        """
        Инициализирует репортёр.
        Args:
            token: Токен Telegram-бота.
            chat_id: ID чата (обычно ваш личный user ID).
        """
        self.enabled = TELEGRAM_AVAILABLE and token and chat_id
        self.token = token
        self.chat_id = chat_id
        self.bot = None
        if self.enabled:
            try:
                self.bot = Bot(token=token)
                log("Telegram reporter initialized", "TELEGRAM")
            except Exception as e:
                log(f"Telegram init error: {e}", "ERROR")
                self.enabled = False
        else:
            log("Telegram reporter disabled (missing token/chat_id or library)", "WARN")
    async def send_async(self, message: str, reply_markup=None) -> None:
        """Асинхронная отправка сообщения."""
        if not self.enabled or not self.bot:
            return
        try:
            await self.bot.send_message(
                chat_id=self.chat_id,
                text=message,
                parse_mode="HTML",
                reply_markup=reply_markup
            )
        except Exception as e:
            log(f"Telegram send error: {e}", "ERROR")
    def send(self, message: str, reply_markup=None) -> None:
        """
        Синхронный wrapper для отправки сообщения.
        Автоматически выбирает подходящий способ запуска asyncio.
        """
        if not self.enabled:
            return
        try:
            asyncio.run(self.send_async(message, reply_markup))
        except RuntimeError:
            # Если уже запущен event loop (например, в основном потоке)
            loop = asyncio.get_event_loop()
            if loop.is_running():
                asyncio.create_task(self.send_async(message, reply_markup))
            else:
                asyncio.run(self.send_async(message, reply_markup))
        except Exception as e:
            log(f"Telegram send wrapper error: {e}", "ERROR")
