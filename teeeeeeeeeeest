class LiveEngine:
    """
    Основной движок бота.
    Подключается к WebSocket Binance, собирает свечи,
    обнаруживает паттерны и управляет демо-позициями.
    """
    def __init__(self):
        self.symbol = MARKET_SYMBOL.lower()
        self.interval = TRADE_INTERVAL
        self.ws_url = f"{FUTURES_WS_BASE}/{self.symbol}@kline_{self.interval}"
        self.ws = None
        self.candle_buffer = deque(maxlen=LIVE_BUFFER_SIZE)
        self.broker = DemoBroker()
        self.running = False
        self.last_report_date = None
        self.last_patterns: List[Tuple] = []
    def start(self) -> None:
        """Запускает движок и вспомогательные потоки."""
        self.running = True
        log("Starting Live Trading Engine...", "START")
        telegram.send("<b>🤖 Live Trading Bot Started</b>")
        ws_thread = threading.Thread(target=self._run_websocket, daemon=True)
        ws_thread.start()
        report_thread = threading.Thread(target=self._daily_report_loop, daemon=True)
        report_thread.start()
    def stop(self) -> None:
        """Останавливает движок и закрывает WebSocket."""
        self.running = False
        if self.ws:
            self.ws.close()
        log("Live Trading Engine stopped", "STOP")
    def _run_websocket(self) -> None:
        """Основной цикл подключения к WebSocket с автопереподключением."""
        while self.running:
            try:
                self.ws = websocket.WebSocketApp(
                    self.ws_url,
                    on_message=self._on_message,
                    on_error=self._on_error,
                    on_close=self._on_close,
                    on_open=self._on_open
                )
                self.ws.run_forever(ping_interval=30, ping_timeout=10)
            except Exception as e:
                log(f"WebSocket error: {e}", "ERROR")
                time.sleep(5)
    def _on_open(self, ws) -> None:
        log("WebSocket connected", "WS")
    def _on_message(self, ws, message: str) -> None:
        """Обрабатывает входящие сообщения от Binance (kline)."""
        try:
            data = json.loads(message)
            if "k" not in data:
                return
            k = data["k"]
            candle = {
                "timestamp": pd.to_datetime(k["t"], unit="ms", utc=True),
                "open": float(k["o"]),
                "high": float(k["h"]),
                "low": float(k["l"]),
                "close": float(k["c"]),
                "volume": float(k["v"]),
                "is_closed": k["x"]
            }
            self.candle_buffer.append(candle)
            current_price = candle["close"]
            self.broker.check_positions(current_price)
            if candle["is_closed"] and len(self.candle_buffer) >= 50:
                self._check_patterns()
        except Exception as e:
            log(f"Message processing error: {e}", "ERROR")
    def _on_error(self, ws, error) -> None:
        log(f"WebSocket error: {error}", "ERROR")
    def _on_close(self, ws, close_status_code, close_msg) -> None:
        log("WebSocket closed", "WS")
    def _check_patterns(self) -> None:
        """Анализирует буфер свечей и открывает позицию при обнаружении паттерна."""
        df = pd.DataFrame(list(self.candle_buffer))
        df = df[["timestamp", "open", "high", "low", "close", "volume"]]
        df = df.set_index("timestamp")
        patterns = detect_all_patterns(df)
        self.last_patterns = patterns[-5:] if len(patterns) >= 5 else patterns
        if not patterns:
            return
        latest_ts, pattern_name = patterns[-1]
        if len(self.broker.positions) > 0:
            log(f"Pattern {pattern_name} detected but position already open", "SKIP")
            return
        cfg = PATTERN_CONFIG.get(pattern_name, {})
        tp_pct = cfg.get("tp", 0.5)
        sl_pct = cfg.get("sl", 0.25)
        scale = cfg.get("scale", 0.5)
        entry_price = df.iloc[-1]["close"]
        side = "LONG"
        if any(x in pattern_name for x in ["Bear", "Descending", "Down", "Rising Wedge", "Head & Shoulders"]):
            side = "SHORT"
        if side == "LONG":
            tp_price = entry_price * (1 + tp_pct / 100)
            sl_price = entry_price * (1 - sl_pct / 100)
        else:
            tp_price = entry_price * (1 - tp_pct / 100)
            sl_price = entry_price * (1 + sl_pct / 100)
        size_usd = BASE_POSITION_USD * (1 + scale)
        self.broker.open_position(
            pattern=pattern_name,
            side=side,
            entry_price=entry_price,
            tp_price=tp_price,
            sl_price=sl_price,
            size_usd=size_usd,
            leverage=DEFAULT_LEVERAGE
        )
    def _daily_report_loop(self) -> None:
        """Цикл отправки ежедневных отчётов в заданное время UTC."""
        while self.running:
            now = datetime.now(timezone.utc)
            if now.hour == DAILY_REPORT_HOUR and now.date() != self.last_report_date:
                self._send_daily_report()
                self.last_report_date = now.date()
            time.sleep(60)
    def _send_daily_report(self) -> None:
        """Формирует и отправляет дневной отчёт."""
        stats = self.broker.get_stats()
        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        save_daily_stats({
            "date": date_str,
            "total_trades": stats["total_trades"],
            "wins": stats["wins"],
            "losses": stats["losses"],
            "total_pnl": stats["total_pnl"],
            "capital": stats["capital"]
        })
        winrate = (stats["wins"] / stats["total_trades"] * 100) if stats["total_trades"] > 0 else 0
        msg = f"<b>📊 Daily Report - {date_str}</b>\n\n"
        msg += f"💰 Capital: ${stats['capital']:.2f}\n"
        msg += f"📈 Total Trades: {stats['total_trades']}\n"
        msg += f"✅ Wins: {stats['wins']} | ❌ Losses: {stats['losses']}\n"
        msg += f"🎯 Win Rate: {winrate:.1f}%\n"
        msg += f"💵 Total PNL: ${stats['total_pnl']:.2f}\n"
        msg += f"📊 Open Positions: {stats['open_positions']}"
        log(msg.replace("<b>", "").replace("</b>", "").replace("💰", "").replace("📈", "")
            .replace("✅", "").replace("❌", "").replace("🎯", "").replace("💵", "").replace("📊", ""), "REPORT")
        telegram.send(msg)
    def get_last_candle_info(self) -> str:
        """Возвращает форматированную информацию о последней закрытой свече."""
        if not self.candle_buffer:
            return "No candle data available"
        last = self.candle_buffer[-1]
        change = ((last['close'] - last['open']) / last['open']) * 100
        candle_type = "Bullish 📈" if last['close'] > last['open'] else "Bearish 📉"
        msg = f"<b>🕯️ Last Candle ({TRADE_INTERVAL})</b>\n\n"
        msg += f"Type: {candle_type}\n"
        msg += f"Open: ${last['open']:.2f}\n"
        msg += f"High: ${last['high']:.2f}\n"
        msg += f"Low: ${last['low']:.2f}\n"
        msg += f"Close: ${last['close']:.2f}\n"
        msg += f"Change: {change:+.2f}%\n"
        msg += f"Volume: {last['volume']:.2f}"
        return msg
    def get_sentiment_info(self) -> str:
        """Возвращает форматированное описание текущего рыночного настроения."""
        if len(self.candle_buffer) < 20:
            return "Not enough data for sentiment analysis"
        df = pd.DataFrame(list(self.candle_buffer))
        df = df[["timestamp", "open", "high", "low", "close", "volume"]]
        df = df.set_index("timestamp")
        sentiment = calculate_market_sentiment(df)
        emoji_map = {
            "BULLISH": "🚀",
            "BEARISH": "🐻",
            "NEUTRAL": "😐",
            "UNCERTAIN": "🤔"
        }
        msg = f"<b>🔮 Market Sentiment</b>\n\n"
        msg += f"Status: {emoji_map.get(sentiment['sentiment'], '')} {sentiment['sentiment']}\n"
        msg += f"Strength: {sentiment['strength']}%\n"
        msg += f"Description: {sentiment['description']}\n\n"
        msg += f"📊 Bullish candles: {sentiment['bullish_candles']}/20\n"
        msg += f"📊 Bearish candles: {sentiment['bearish_candles']}/20\n"
        msg += f"📊 Volatility: {sentiment['volatility']}%\n\n"
        msg += f"Price vs EMA9: {sentiment['price_vs_ema9']}\n"
        msg += f"Price vs EMA21: {sentiment['price_vs_ema21']}"
        return msg
