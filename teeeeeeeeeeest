def fetch_historical_data(start_date: str, end_date: str) -> List[Dict]:
    """
    Загружает исторические данные свечей с Binance за период.
    Args:
        start_date: Начальная дата (YYYY-MM-DD)
        end_date: Конечная дата (YYYY-MM-DD)
    Returns:
        Список словарей с данными свечей.
    """
    symbol = MARKET_SYMBOL
    interval = TRADE_INTERVAL
    start_ts = int(datetime.strptime(start_date, "%Y-%m-%d").replace(tzinfo=timezone.utc).timestamp() * 1000)
    end_ts = int(datetime.strptime(end_date, "%Y-%m-%d").replace(tzinfo=timezone.utc).timestamp() * 1000)
    limit = 1000  # Максимум на запрос
    klines = []
    while start_ts < end_ts:
        url = f"{FUTURES_REST_BASE}/fapi/v1/klines"
        params = {
            "symbol": symbol,
            "interval": interval,
            "startTime": start_ts,
            "endTime": end_ts,
            "limit": limit
        }
        try:
            response = requests.get(url, params=params)
            data = response.json()
            if not data:
                break
            klines.extend(data)
            start_ts = data[-1][0] + 1  # Следующий после последней свечи
        except Exception as e:
            log(f"Error fetching historical data: {e}", "ERROR")
            break
    candles = []
    for k in klines:
        candles.append({
            "timestamp": pd.to_datetime(k[0], unit="ms", utc=True),
            "open": float(k[1]),
            "high": float(k[2]),
            "low": float(k[3]),
            "close": float(k[4]),
            "volume": float(k[5]),
            "is_closed": True  # Все исторические свечи закрыты
        })
    log(f"Fetched {len(candles)} candles from {start_date} to {end_date}", "BACKTEST")
    return candles

def run_backtest(start_date: str, end_date: str):
    """
    Запускает бэктест на исторических данных.
    Симулирует торговлю, как в живом режиме.
    """
    historical_candles = fetch_historical_data(start_date, end_date)
    if not historical_candles:
        log("No historical data fetched. Exiting backtest.", "ERROR")
        return

    broker = DemoBroker()  # Отдельный брокер для бэктеста
    candle_buffer = deque(maxlen=LIVE_BUFFER_SIZE)
    last_patterns: List[Tuple] = []

    for candle in historical_candles:
        candle_buffer.append(candle)
        current_price = candle["close"]
        broker.check_positions(current_price)
        if len(candle_buffer) >= 50:
            df = pd.DataFrame(list(candle_buffer))
            df = df[["timestamp", "open", "high", "low", "close", "volume"]]
            df = df.set_index("timestamp")
            patterns = detect_all_patterns(df)
            last_patterns = patterns[-5:] if len(patterns) >= 5 else patterns
            if patterns:
                latest_ts, pattern_name = patterns[-1]
                if len(broker.positions) > 0:
                    log(f"Pattern {pattern_name} detected but position already open", "SKIP")
                    continue
                cfg = PATTERN_CONFIG.get(pattern_name, {})
                tp_pct = cfg.get("tp", 0.5)
                sl_pct = cfg.get("sl", 0.25)
                scale = cfg.get("scale", 0.5)
                entry_price = df.iloc[-1]["close"]
                side = "LONG"
                if any(x in pattern_name for x in ["Bear", "Descending", "Down", "Rising Wedge", "Head & Shoulders"]):
                    side = "SHORT"
                if side == "LONG":
                    tp_price = entry_price * (1 + tp_pct / 100)
                    sl_price = entry_price * (1 - sl_pct / 100)
                else:
                    tp_price = entry_price * (1 - tp_pct / 100)
                    sl_price = entry_price * (1 + sl_pct / 100)
                size_usd = BASE_POSITION_USD * (1 + scale)
                broker.open_position(
                    pattern=pattern_name,
                    side=side,
                    entry_price=entry_price,
                    tp_price=tp_price,
                    sl_price=sl_price,
                    size_usd=size_usd,
                    leverage=DEFAULT_LEVERAGE
                )

    # В конце бэктеста закрыть все открытые позиции по последней цене
    if broker.positions and historical_candles:
        last_price = historical_candles[-1]["close"]
        for pos in broker.positions[:]:
            pnl = broker._calculate_pnl(pos, last_price)
            close_time = int(time.time() * 1000)
            close_position(pos["db_id"], close_time, last_price, pnl)
            broker.capital += pnl
            broker.closed_positions.append({**pos, "close_price": last_price, "pnl": pnl})
            broker.positions.remove(pos)
            log(f"BACKTEST: Forced close position {pos['pattern']} @ {last_price:.2f} | PNL: {pnl:.2f}", "TRADE")

    stats = broker.get_stats()
    winrate = (stats["wins"] / stats["total_trades"] * 100) if stats["total_trades"] > 0 else 0
    msg = f"<b>📊 Backtest Report: {start_date} to {end_date}</b>\n\n"
    msg += f"💰 Final Capital: ${stats['capital']:.2f}\n"
    msg += f"📈 Total Trades: {stats['total_trades']}\n"
    msg += f"✅ Wins: {stats['wins']} | ❌ Losses: {stats['losses']}\n"
    msg += f"🎯 Win Rate: {winrate:.1f}%\n"
    msg += f"💵 Total PNL: ${stats['total_pnl']:.2f}"
    log(msg.replace("<b>", "").replace("</b>", ""), "BACKTEST")
    telegram.send(msg)
