                self.ws = websocket.WebSocketApp(
                    self.ws_url,
                    on_message=self._on_message,
                    on_error=self._on_error,
                    on_close=self._on_close,
                    on_open=self._on_open
                )
                self.ws.run_forever(ping_interval=30, ping_timeout=10)
            except Exception as e:
                log(f"WebSocket error: {e}", "ERROR")
                time.sleep(5)

    def _on_open(self, ws) -> None:
        log("WebSocket connected", "WS")

    def _on_message(self, ws, message: str) -> None:
        """Обрабатывает входящие сообщения от Binance (kline)."""
        try:
            data = json.loads(message)
            if "k" not in data:
                return

            k = data["k"]
            candle = {
                "timestamp": pd.to_datetime(k["t"], unit="ms", utc=True),
                "open": float(k["o"]),
                "high": float(k["h"]),
                "low": float(k["l"]),
                "close": float(k["c"]),
                "volume": float(k["v"]),
                "is_closed": k["x"]
            }

            self.candle_buffer.append(candle)
            current_price = candle["close"]

            self.broker.check_positions(current_price)

            if candle["is_closed"] and len(self.candle_buffer) >= 50:
                self._check_patterns()

        except Exception as e:
            log(f"Message processing error: {e}", "ERROR")

    def _on_error(self, ws, error) -> None:
        log(f"WebSocket error: {error}", "ERROR")

    def _on_close(self, ws, close_status_code, close_msg) -> None:
        log("WebSocket closed", "WS")

    def _pattern_test_loop(self) -> None:
        """Цикл принудительной генерации паттернов для тестирования."""
        log("Pattern testing loop started", "TEST")
        
        while self.running:
            try:
                pattern = self.pattern_tester.should_inject_pattern()
                
                if pattern and len(self.candle_buffer) > 0:
                    current_price = self.candle_buffer[-1]["close"]
                    self._open_test_position(pattern, current_price)
                    
                time.sleep(300)  # Проверяем каждые 5 минут
                
            except Exception as e:
                log(f"Pattern test loop error: {e}", "ERROR")
                time.sleep(60)

    def _open_test_position(self, pattern: str, current_price: float) -> None:
        """
        Открывает тестовую позицию для заданного паттерна.

        Args:
            pattern: Название паттерна.
            current_price: Текущая цена.
        """
        if len(self.broker.positions) >= MAX_OPEN_POSITIONS:
            log(f"Skipping test pattern {pattern} - max positions limit reached", "TEST")
            return

        cfg = PATTERN_CONFIG.get(pattern, {})
        tp_pct = cfg.get("tp", 0.5)
        sl_pct = cfg.get("sl", 0.25)
        scale = cfg.get("scale", 0.5)

        side = "LONG"
        if any(x in pattern for x in ["Bear", "Descending", "Down", "Rising Wedge", "Head & Shoulders"]):
            side = "SHORT"

        entry_price = current_price

        if side == "LONG":
            tp_price = entry_price * (1 + tp_pct / 100)
            sl_price = entry_price * (1 - sl_pct / 100)
        else:
            tp_price = entry_price * (1 - tp_pct / 100)
            sl_price = entry_price * (1 + sl_pct / 100)

        size_usd = BASE_POSITION_USD * (1 + scale)

        self.broker.open_position(
            pattern=pattern,
            side=side,
            entry_price=entry_price,
            tp_price=tp_price,
            sl_price=sl_price,
            size_usd=size_usd,
            leverage=DEFAULT_LEVERAGE,
            is_test_pattern=True
        )

        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        update_pattern_stats(date_str, pattern)
        self.pattern_tester.mark_pattern_used(pattern)
        
        log(f"Test pattern {pattern} injected successfully", "TEST")

    def _check_patterns(self) -> None:
        """Анализирует буфер свечей и открывает позицию при обнаружении паттерна."""
        df = pd.DataFrame(list(self.candle_buffer))
        df = df[["timestamp", "open", "high", "low", "close", "volume"]]
        df = df.set_index("timestamp")

        patterns = detect_all_patterns(df)
        self.last_patterns = patterns[-5:] if len(patterns) >= 5 else patterns

        if not patterns:
            return

        latest_ts, pattern_name = patterns[-1]
        current_price = df.iloc[-1]["close"]

        # Проверяем, можем ли открыть ещё позицию
        if len(self.broker.positions) >= MAX_OPEN_POSITIONS:
            log(f"Pattern {pattern_name} detected but max positions limit reached ({MAX_OPEN_POSITIONS})", "SKIP")
            return

        cfg = PATTERN_CONFIG.get(pattern_name, {})
        tp_pct = cfg.get("tp", 0.5)
        sl_pct = cfg.get("sl", 0.25)
        scale = cfg.get("scale", 0.5)

        entry_price = current_price
        side = "LONG"
        if any(x in pattern_name for x in ["Bear", "Descending", "Down", "Rising Wedge", "Head & Shoulders"]):
            side = "SHORT"

        # Проверка на пирамидинг и усреднение
        same_direction_positions = [p for p in self.broker.positions if p["side"] == side]
        
        if same_direction_positions:
            if not ALLOW_SAME_DIRECTION:
                log(f"Pattern {pattern_name} detected but same direction disabled", "SKIP")
                return
            
            # Логика пирамидинга (добавление к прибыльной позиции)
            for pos in same_direction_positions:
                if side == "LONG":
                    profit_pct = ((current_price - pos["entry_price"]) / pos["entry_price"]) * 100
                else:
                    profit_pct = ((pos["entry_price"] - current_price) / pos["entry_price"]) * 100
                
                if profit_pct > 0.1 and PYRAMIDING_ENABLED:
                    log(f"PYRAMIDING: Adding to profitable {side} position (+{profit_pct:.2f}%)", "STRATEGY")
                    break
                elif profit_pct < -0.05 and AVERAGING_ENABLED:
                    log(f"AVERAGING: Adding to losing {side} position ({profit_pct:.2f}%)", "STRATEGY")
                    break
        
        # Проверка противоположного направления (хеджирование)
        opposite_positions = [p for p in self.broker.positions if p["side"] != side]
        if opposite_positions and not ALLOW_OPPOSITE_DIRECTION:
            log(f"Pattern {pattern_name} detected but opposite direction disabled", "SKIP")
            return

        if side == "LONG":
            tp_price = entry_price * (1 + tp_pct / 100)
            sl_price = entry_price * (1 - sl_pct / 100)
        else:
            tp_price = entry_price * (1 - tp_pct / 100)
            sl_price = entry_price * (1 + sl_pct / 100)

        size_usd = BASE_POSITION_USD * (1 + scale)

        self.broker.open_position(
            pattern=pattern_name,
            side=side,
            entry_price=entry_price,
            tp_price=tp_price,
            sl_price=sl_price,
            size_usd=size_usd,
            leverage=DEFAULT_LEVERAGE,
            is_test_pattern=False
        )

        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        update_pattern_stats(date_str, pattern_name)
        self.pattern_tester.mark_pattern_used(pattern_name)

    def _daily_report_loop(self) -> None:
        """Цикл отправки ежедневных, еженедельных и месячных отчётов."""
        while self.running:
            now = datetime.now(timezone.utc)
            
            # Дневной отчёт
            if now.hour == DAILY_REPORT_HOUR and now.date() != self.last_report_date:
                self._send_daily_report()
                self.last_report_date = now.date()
                
                # Еженедельный отчёт (понедельник)
                if SEND_WEEKLY_REPORT and now.weekday() == WEEKLY_REPORT_DAY:
                    self._send_weekly_report()
                
                # Месячный отчёт (1 число месяца)
                if SEND_MONTHLY_SUMMARY and now.day == 1:
                    self._send_monthly_report()
                
