def generate_candle_report(candle: Dict, patterns: List[Dict], sentiment: Dict, 
                          signal_analysis: Dict, market_structure: str) -> str:
    """Генерирует ГРАНДИОЗНЫЙ отчёт о новой свече."""
    
    sentiment_emoji = {
        "BULLISH": "🚀",
        "BEARISH": "🐻",
        "NEUTRAL": "😐",
        "UNCERTAIN": "🤔",
        "UNKNOWN": "❓"
    }
    
    candle_change = ((candle['close'] - candle['open']) / candle['open']) * 100
    candle_type = "🟢 BULLISH" if candle_change > 0 else "🔴 BEARISH"
    candle_size = abs(candle_change)
    
    if candle_size > 2.0:
        candle_strength = "⚡ EXPLOSIVE"
    elif candle_size > 1.0:
        candle_strength = "💪 STRONG"
    elif candle_size > 0.5:
        candle_strength = "📊 MODERATE"
    else:
        candle_strength = "😴 WEAK"
    
    msg = "═" * 30 + "\n"
    msg += "🎊 NEW CANDLE EVENT 🎊\n"
    msg += "═" * 30 + "\n\n"
    
    msg += "📊 CANDLE DATA\n"
    msg += f"⏰ Time: {candle['timestamp'].strftime('%Y-%m-%d %H:%M UTC')}\n"
    msg += f"📈 Type: {candle_type}\n"
    msg += f"💪 Strength: {candle_strength}\n"
    msg += f"🎯 O: ${candle['open']:.2f} | H: ${candle['high']:.2f}\n"
    msg += f"🎯 L: ${candle['low']:.2f} | C: ${candle['close']:.2f}\n"
    msg += f"📊 Change: {candle_change:+.2f}%\n"
    msg += f"📦 Volume: {candle['volume']:.2f}\n\n"
    
    msg += "🔮 MARKET SENTIMENT\n"
    msg += f"{sentiment_emoji.get(sentiment['sentiment'], '❓')} Status: {sentiment['sentiment']}\n"
    msg += f"💯 Strength: {sentiment['strength']}%\n"
    msg += f"📝 {sentiment['description']}\n"
    msg += f"📈 Bullish candles: {sentiment['bullish_candles']}/20\n"
    msg += f"📉 Bearish candles: {sentiment['bearish_candles']}/20\n"
    msg += f"🌊 Volatility: {sentiment['volatility']}%\n"
    msg += f"📊 Trend: {sentiment.get('trend', 'N/A')}\n\n"
    
    msg += "🏗️ MARKET STRUCTURE\n"
    msg += f"📐 Pattern: {market_structure}\n"
    msg += f"📊 EMA9: ${sentiment.get('ema9', 0):.2f}\n"
    msg += f"📊 EMA21: ${sentiment.get('ema21', 0):.2f}\n\n"
    
    if patterns:
        msg += f"🎯 DETECTED PATTERNS ({len(patterns)})\n"
        for i, p in enumerate(patterns[:7], 1):
            conf_bar = "█" * (p['confidence'] // 10) + "░" * (10 - p['confidence'] // 10)
            msg += f"{i}. {p['name']}\n"
            msg += f"   Confidence: {conf_bar} {p['confidence']}%\n"
        
        if len(patterns) > 7:
            msg += f"   ... and {len(patterns) - 7} more patterns\n"
        msg += "\n"
    else:
        msg += "🎯 DETECTED PATTERNS\n"
        msg += "No patterns detected on this candle\n\n"
    
    if signal_analysis['main_signal']:
        msg += "🔍 SIGNAL-IN-SIGNAL ANALYSIS\n"
        msg += f"🎯 Main Signal: {signal_analysis['main_signal']['name']}\n"
        msg += f"📍 Direction: {signal_analysis['signal_direction']}\n"
        msg += f"💯 Total Confidence: {signal_analysis['total_confidence']}%\n"
        msg += f"🔗 Confluence: {signal_analysis['confluence_count']} signals aligned\n"
        
        if signal_analysis['conflicting_signals'] > 0:
            msg += f"⚠️ Conflicting signals: {signal_analysis['conflicting_signals']}\n"
        
        msg += f"\n🎲 Nested Signals:\n"
        for sig in signal_analysis['nested_signals'][:5]:
            msg += f"  • {sig['name']} ({sig['confidence']}%)\n"
        
        if signal_analysis['total_confidence'] >= 80:
            msg += f"\n✅ STRONG SIGNAL - HIGH PROBABILITY TRADE\n"
        elif signal_analysis['total_confidence'] >= 65:
            msg += f"\n⚠️ MODERATE SIGNAL - WATCH CLOSELY\n"
        else:
            msg += f"\n❌ WEAK SIGNAL - WAIT FOR BETTER SETUP\n"
        
        msg += "\n"
    else:
        msg += "🔍 SIGNAL-IN-SIGNAL ANALYSIS\n"
        msg += "No actionable signals detected\n\n"
    
    msg += "═" * 30 + "\n"
    msg += "📊 Live Trading Bot | BTCUSDT\n"
    msg += "═" * 30
    
    return msg

