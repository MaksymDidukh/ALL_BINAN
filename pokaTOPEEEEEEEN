class DemoBroker:
    """Демо-брокер с управлением позициями."""
    
    def __init__(self):
        self.capital = INITIAL_CAPITAL
        self.positions: List[Dict] = []
        self.closed_positions: List[Dict] = []
        self.lock = threading.Lock()
    
    def open_position(self, pattern: str, side: str, entry_price: float, 
                     tp_price: float, sl_price: float, size_usd: float, 
                     leverage: int, confidence: int = 0, nested_signals: List = None) -> None:
        """Открывает демо-позицию."""
        with self.lock:
            pos = {
                "open_time": int(time.time() * 1000),
                "pattern": pattern,
                "side": side,
                "entry_price": entry_price,
                "size_usd": size_usd,
                "leverage": leverage,
                "tp_price": tp_price,
                "sl_price": sl_price,
                "qty": (size_usd * leverage) / entry_price,
                "confidence": confidence,
                "nested_signals": nested_signals or []
            }
            
            save_position(pos)
            self.positions.append(pos)
            
            log(f"POSITION OPENED: {side} {pattern} @ {entry_price:.2f} | Confidence: {confidence}%", "TRADE")
            
            msg = f"🔔 NEW POSITION OPENED\n\n"
            msg += f"📊 Main Pattern: {pattern}\n"
            msg += f"{'📈' if side == 'LONG' else '📉'} Side: {side}\n"
            msg += f"💰 Entry: ${entry_price:.2f}\n"
            msg += f"🎯 Take Profit: ${tp_price:.2f}\n"
            msg += f"🛑 Stop Loss: ${sl_price:.2f}\n"
            msg += f"💵 Size: ${size_usd:.2f} x{leverage}\n"
            msg += f"🎲 Confidence: {confidence}%\n\n"
            
            if nested_signals:
                msg += f"🔍 Nested Signals ({len(nested_signals)}):\n"
                for sig in nested_signals[:5]:
                    msg += f"  • {sig['name']} ({sig['confidence']}%)\n"
            
            telegram.send(msg)
    
    def check_positions(self, current_price: float) -> None:
        """Проверяет позиции на TP/SL."""
        with self.lock:
            for pos in self.positions[:]:
                hit_tp = (pos["side"] == "LONG" and current_price >= pos["tp_price"]) or \
                         (pos["side"] == "SHORT" and current_price <= pos["tp_price"])
                hit_sl = (pos["side"] == "LONG" and current_price <= pos["sl_price"]) or \
                         (pos["side"] == "SHORT" and current_price >= pos["sl_price"])
                
                if hit_tp or hit_sl:
                    close_price = pos["tp_price"] if hit_tp else pos["sl_price"]
                    pnl = self._calculate_pnl(pos, close_price)
                    close_time = int(time.time() * 1000)
                    
                    close_position(pos["db_id"], close_time, close_price, pnl)
                    self.capital += pnl
                    self.positions.remove(pos)
                    self.closed_positions.append({**pos, "close_price": close_price, "pnl": pnl})
                    
                    result = "✅ TP HIT" if hit_tp else "❌ SL HIT"
                    log(f"POSITION CLOSED: {result} {pos['pattern']} @ {close_price:.2f} | PNL: {pnl:.2f}", "TRADE")
                    
                    msg = f"{'✅' if hit_tp else '❌'} {result}\n\n"
                    msg += f"📊 Pattern: {pos['pattern']}\n"
                    msg += f"Side: {pos['side']}\n"
                    msg += f"Entry: ${pos['entry_price']:.2f}\n"
                    msg += f"Exit: ${close_price:.2f}\n"
                    msg += f"{'💰' if pnl > 0 else '💸'} PNL: ${pnl:+.2f}\n"
                    msg += f"💵 Capital: ${self.capital:.2f}\n"
                    msg += f"🎲 Confidence was: {pos['confidence']}%"
                    
                    telegram.send(msg)
    
    def _calculate_pnl(self, pos: Dict, close_price: float) -> float:
        """Расчёт PnL с комиссией."""
        if pos["side"] == "LONG":
            price_diff = close_price - pos["entry_price"]
        else:
            price_diff = pos["entry_price"] - close_price
        
        pnl = price_diff * pos["qty"]
        fee = pos["size_usd"] * pos["leverage"] * FEE_RATE * 2
        return pnl - fee
    
    def get_stats(self) -> Dict[str, Any]:
        """Возвращает статистику."""
        with self.lock:
            total = len(self.closed_positions)
            wins = sum(1 for p in self.closed_positions if p["pnl"] > 0)
            losses = total - wins
            total_pnl = sum(p["pnl"] for p in self.closed_positions)
            
            return {
                "capital": self.capital,
                "total_trades": total,
                "wins": wins,
                "losses": losses,
                "total_pnl": total_pnl,
                "open_positions": len(self.positions)
            }

