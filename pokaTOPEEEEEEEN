def calculate_market_sentiment(df: pd.DataFrame) -> Dict[str, Any]:
    """Анализирует рыночное настроение."""
    if len(df) < 20:
        return {
            "sentiment": "UNKNOWN",
            "strength": 0,
            "description": "Not enough data",
            "bullish_candles": 0,
            "bearish_candles": 0,
            "volatility": 0,
            "trend": "UNKNOWN"
        }
    
    recent = df.iloc[-20:]
    bullish_candles = (recent['close'] > recent['open']).sum()
    bearish_candles = (recent['close'] < recent['open']).sum()
    
    ema9 = df['close'].ewm(span=9, adjust=False).mean().iloc[-1]
    ema21 = df['close'].ewm(span=21, adjust=False).mean().iloc[-1]
    ema50 = df['close'].ewm(span=50, adjust=False).mean().iloc[-1] if len(df) >= 50 else ema21
    
    current_price = df['close'].iloc[-1]
    volatility = (df['high'].iloc[-20:] - df['low'].iloc[-20:]).mean() / df['close'].iloc[-20:].mean() * 100
    
    if current_price > ema9 > ema21 > ema50:
        trend = "STRONG UPTREND"
    elif current_price < ema9 < ema21 < ema50:
        trend = "STRONG DOWNTREND"
    elif current_price > ema9 and ema9 > ema21:
        trend = "UPTREND"
    elif current_price < ema9 and ema9 < ema21:
        trend = "DOWNTREND"
    else:
        trend = "SIDEWAYS"
    
    if bullish_candles > bearish_candles * 1.5 and current_price > ema9 > ema21:
        sentiment = "BULLISH"
        strength = min(100, int((bullish_candles / 20) * 100))
        description = "Strong uptrend with momentum"
    elif bearish_candles > bullish_candles * 1.5 and current_price < ema9 < ema21:
        sentiment = "BEARISH"
        strength = min(100, int((bearish_candles / 20) * 100))
        description = "Strong downtrend with pressure"
    elif abs(bullish_candles - bearish_candles) <= 3:
        sentiment = "NEUTRAL"
        strength = 50
        description = "Sideways consolidation"
    else:
        sentiment = "UNCERTAIN"
        strength = 60
        description = "Weak trend or reversal forming"
    
    return {
        "sentiment": sentiment,
        "strength": strength,
        "description": description,
        "bullish_candles": int(bullish_candles),
        "bearish_candles": int(bearish_candles),
        "volatility": round(float(volatility), 2),
        "trend": trend,
        "ema9": round(float(ema9), 2),
        "ema21": round(float(ema21), 2)
    }

def get_market_structure(df: pd.DataFrame) -> str:
    """Определяет рыночную структуру (Higher Highs/Lower Lows)."""
    if len(df) < 10:
        return "UNKNOWN"
    
    try:
        highs, lows = local_extrema(df, 5)
        
        if len(highs) >= 2 and len(lows) >= 2:
            # Получаем последние 2 максимума и минимума
            recent_high_indices = highs[-2:]
            recent_low_indices = lows[-2:]
            
            # Извлекаем значения как float, а не Series
            recent_highs = []
            for h in recent_high_indices:
                if h in df.index:
                    val = df.loc[h, 'high']
                    # Если это Series, берём первое значение
                    if hasattr(val, 'iloc'):
                        val = val.iloc[0]
                    recent_highs.append(float(val))
            
            recent_lows = []
            for l in recent_low_indices:
                if l in df.index:
                    val = df.loc[l, 'low']
                    # Если это Series, берём первое значение
                    if hasattr(val, 'iloc'):
                        val = val.iloc[0]
                    recent_lows.append(float(val))
            
            if len(recent_highs) == 2 and len(recent_lows) == 2:
                if recent_highs[1] > recent_highs[0] and recent_lows[1] > recent_lows[0]:
                    return "BULLISH (HH/HL)"
                elif recent_highs[1] < recent_highs[0] and recent_lows[1] < recent_lows[0]:
                    return "BEARISH (LH/LL)"
                else:
                    return "CHOPPY"
    except Exception as e:
        log(f"Market structure error: {e}", "WARN")
    
    return "CONSOLIDATION"

