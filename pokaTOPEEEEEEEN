def local_extrema(df: pd.DataFrame, window: int = 5) -> Tuple[List[int], List[int]]:
    """Находит локальные максимумы и минимумы."""
    high_max = df['high'].rolling(window, center=True).max()
    low_min = df['low'].rolling(window, center=True).min()
    highs = df[df['high'] == high_max].index.tolist()
    lows = df[df['low'] == low_min].index.tolist()
    return highs, lows

def detect_flags(df: pd.DataFrame, lookback: int = 20, threshold: float = 0.005) -> List[Dict]:
    """Обнаруживает флаги с метаданными."""
    patterns = []
    for i in range(lookback, len(df)):
        seg = df['close'].iloc[i-lookback:i]
        diff = seg.max() - seg.min()
        if seg.min() <= 0:
            continue
        if diff / seg.min() < threshold:
            slope = (seg.iloc[-1] - seg.iloc[0]) / seg.iloc[0]
            if slope > 0.0:
                patterns.append({
                    "timestamp": seg.index[-1],
                    "name": "Bullish Flag",
                    "confidence": 70,
                    "metadata": {"slope": slope}
                })
            elif slope < 0.0:
                patterns.append({
                    "timestamp": seg.index[-1],
                    "name": "Bearish Flag",
                    "confidence": 70,
                    "metadata": {"slope": slope}
                })
    return patterns

def detect_triangles(df: pd.DataFrame, lookback: int = 24) -> List[Dict]:
    """Обнаруживает треугольники."""
    patterns = []
    for i in range(lookback, len(df)):
        seg = df.iloc[i-lookback:i]
        x = np.arange(len(seg))
        try:
            high_coef = np.polyfit(x, seg['high'].values, 1)[0]
            low_coef = np.polyfit(x, seg['low'].values, 1)[0]
        except Exception:
            continue
        
        if abs(high_coef) < 0.001 and low_coef > 0.0:
            patterns.append({
                "timestamp": seg.index[-1],
                "name": "Ascending Triangle",
                "confidence": 80,
                "metadata": {"high_slope": high_coef, "low_slope": low_coef}
            })
        elif abs(low_coef) < 0.001 and high_coef < 0.0:
            patterns.append({
                "timestamp": seg.index[-1],
                "name": "Descending Triangle",
                "confidence": 80,
                "metadata": {"high_slope": high_coef, "low_slope": low_coef}
            })
        elif high_coef < 0 and low_coef > 0:
            patterns.append({
                "timestamp": seg.index[-1],
                "name": "Symmetrical Triangle",
                "confidence": 65,
                "metadata": {"high_slope": high_coef, "low_slope": low_coef}
            })
    return patterns

def detect_fvg(df: pd.DataFrame, gap_perc: float = 0.002) -> List[Dict]:
    """Обнаруживает Fair Value Gap."""
    patterns = []
    for i in range(2, len(df)):
        prev_high = df['high'].iloc[i-2]
        prev_low = df['low'].iloc[i-2]
        curr_open = df['open'].iloc[i]
        
        if curr_open > prev_high * (1 + gap_perc):
            gap_size = (curr_open - prev_high) / prev_high * 100
            patterns.append({
                "timestamp": df.index[i],
                "name": "FVG Up",
                "confidence": 60,
                "metadata": {"gap_size": gap_size}
            })
        elif curr_open < prev_low * (1 - gap_perc):
            gap_size = (prev_low - curr_open) / prev_low * 100
            patterns.append({
                "timestamp": df.index[i],
                "name": "FVG Down",
                "confidence": 60,
                "metadata": {"gap_size": gap_size}
            })
    return patterns

def detect_bos(df: pd.DataFrame, window: int = 5) -> List[Dict]:
    """Обнаруживает Break of Structure."""
    patterns = []
    highs, lows = local_extrema(df, window)
    
    for i in range(1, len(highs)):
        try:
            if df.loc[highs[i], 'high'] > df.loc[highs[i-1], 'high']:
                strength = (df.loc[highs[i], 'high'] - df.loc[highs[i-1], 'high']) / df.loc[highs[i-1], 'high'] * 100
                patterns.append({
                    "timestamp": highs[i],
                    "name": "BOS Up",
                    "confidence": 85,
                    "metadata": {"strength": strength}
                })
        except Exception:
            continue
    
    for i in range(1, len(lows)):
        try:
            if df.loc[lows[i], 'low'] < df.loc[lows[i-1], 'low']:
                strength = (df.loc[lows[i-1], 'low'] - df.loc[lows[i], 'low']) / df.loc[lows[i-1], 'low'] * 100
                patterns.append({
                    "timestamp": lows[i],
                    "name": "BOS Down",
                    "confidence": 85,
                    "metadata": {"strength": strength}
                })
        except Exception:
            continue
    
    return patterns

def detect_head_shoulders(df: pd.DataFrame, window: int = 5, threshold: float = 0.01) -> List[Dict]:
    """Обнаруживает Head & Shoulders."""
    patterns = []
    for i in range(window, len(df) - window):
        left_max = df['high'].iloc[i-window:i].max()
        head = df['high'].iloc[i]
        right_max = df['high'].iloc[i+1:i+1+window].max()
        
        if head > left_max * (1 + threshold) and head > right_max * (1 + threshold):
            patterns.append({
                "timestamp": df.index[i],
                "name": "Head & Shoulders",
                "confidence": 90,
                "metadata": {"head_height": head}
            })
    return patterns

def detect_double_patterns(df: pd.DataFrame, window: int = 10, tolerance: float = 0.005) -> List[Dict]:
    """Обнаруживает Double Top/Bottom."""
    patterns = []
    highs, lows = local_extrema(df, window)
    
    for i in range(1, len(highs)):
        try:
            h1 = df.loc[highs[i-1], 'high']
            h2 = df.loc[highs[i], 'high']
            if abs(h1 - h2) / h1 < tolerance:
                patterns.append({
                    "timestamp": highs[i],
                    "name": "Double Top",
                    "confidence": 85,
                    "metadata": {"level": h2}
                })
        except Exception:
            continue
    
    for i in range(1, len(lows)):
        try:
            l1 = df.loc[lows[i-1], 'low']
            l2 = df.loc[lows[i], 'low']
            if abs(l1 - l2) / l1 < tolerance:
                patterns.append({
                    "timestamp": lows[i],
                    "name": "Double Bottom",
                    "confidence": 85,
                    "metadata": {"level": l2}
                })
        except Exception:
            continue
    
    return patterns

def detect_support_resistance(df: pd.DataFrame, window: int = 20) -> List[Dict]:
    """Обнаруживает уровни поддержки/сопротивления и отскоки."""
    patterns = []
    if len(df) < window:
        return patterns
    
    highs, lows = local_extrema(df, 5)
    last_candle = df.iloc[-1]
    last_close = last_candle['close']
    last_low = last_candle['low']
    last_high = last_candle['high']
    
    recent_lows = [df.loc[idx, 'low'] for idx in lows if idx in df.index[-window:]]
    if len(recent_lows) >= 2:
        support_level = np.mean(recent_lows)
        if abs(last_low - support_level) / support_level < 0.01 and last_close > last_low:
            patterns.append({
                "timestamp": df.index[-1],
                "name": "Support Bounce",
                "confidence": 70,
                "metadata": {"support_level": support_level}
            })
    
    recent_highs = [df.loc[idx, 'high'] for idx in highs if idx in df.index[-window:]]
    if len(recent_highs) >= 2:
        resistance_level = np.mean(recent_highs)
        if abs(last_high - resistance_level) / resistance_level < 0.01 and last_close < last_high:
            patterns.append({
                "timestamp": df.index[-1],
                "name": "Resistance Rejection",
                "confidence": 70,
                "metadata": {"resistance_level": resistance_level}
            })
    
    return patterns

def detect_all_patterns(df: pd.DataFrame) -> List[Dict]:
    """Запускает все функции обнаружения паттернов."""
    all_patterns = []
    try:
        all_patterns += detect_flags(df)
        all_patterns += detect_triangles(df)
        all_patterns += detect_fvg(df)
        all_patterns += detect_bos(df)
        all_patterns += detect_head_shoulders(df)
        all_patterns += detect_double_patterns(df)
        all_patterns += detect_support_resistance(df)
    except Exception as e:
        log(f"Pattern detection error: {e}", "ERROR")
    
    return all_patterns

# ========================= SIGNAL-IN-SIGNAL ANALYSIS =========================

def analyze_nested_signals(patterns: List[Dict], current_price: float) -> Dict[str, Any]:
    """Анализирует вложенные сигналы и вычисляет итоговую уверенность."""
    if not patterns:
        return {
            "main_signal": None,
            "nested_signals": [],
            "total_confidence": 0,
            "signal_direction": "NEUTRAL",
            "confluence_count": 0
        }
    
    bullish_patterns = []
    bearish_patterns = []
    
    for p in patterns:
        name = p["name"]
        if any(x in name for x in ["Bullish", "Ascending", "Up", "Bottom", "Support"]):
            bullish_patterns.append(p)
        elif any(x in name for x in ["Bearish", "Descending", "Down", "Top", "Resistance", "Head & Shoulders"]):
            bearish_patterns.append(p)
    
    if len(bullish_patterns) > len(bearish_patterns):
        main_signal = max(bullish_patterns, key=lambda x: x["confidence"])
        direction = "LONG"
        relevant_patterns = bullish_patterns
    elif len(bearish_patterns) > len(bullish_patterns):
        main_signal = max(bearish_patterns, key=lambda x: x["confidence"])
        direction = "SHORT"
        relevant_patterns = bearish_patterns
    else:
        all_sorted = sorted(patterns, key=lambda x: x["confidence"], reverse=True)
        main_signal = all_sorted[0]
        direction = "LONG" if any(x in main_signal["name"] for x in ["Bullish", "Up", "Bottom"]) else "SHORT"
        relevant_patterns = bullish_patterns if direction == "LONG" else bearish_patterns
    
    confluence_count = len(relevant_patterns)
    confluence_bonus = min(confluence_count - 1, 3) * CONFLUENCE_BONUS
    
    base_confidence = main_signal["confidence"]
    total_confidence = min(100, base_confidence + confluence_bonus)
    
    return {
        "main_signal": main_signal,
        "nested_signals": relevant_patterns,
        "total_confidence": total_confidence,
        "signal_direction": direction,
        "confluence_count": confluence_count,
        "conflicting_signals": len(bullish_patterns if direction == "SHORT" else bearish_patterns)
    }

