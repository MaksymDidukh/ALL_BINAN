class LiveEngine:
    """Основной движок бота с полным анализом."""
    
    def __init__(self):
        self.symbol = MARKET_SYMBOL.lower()
        self.interval = TRADE_INTERVAL
        self.ws_url = f"{FUTURES_WS_BASE}/{self.symbol}@kline_{self.interval}"
        self.ws = None
        self.candle_buffer = deque(maxlen=LIVE_BUFFER_SIZE)
        self.broker = DemoBroker()
        self.running = False
        self.last_report_date = None
        self.last_patterns: List[Dict] = []
        self.candle_count = 0
    
    def start(self) -> None:
        """Запускает движок."""
        self.running = True
        log("Starting Live Trading Engine with Signal-in-Signal Analysis...", "START")
        telegram.send("🤖 Live Trading Bot Started\n\n🔍 Signal-in-Signal Analysis: ENABLED\n📊 Candle Reports: ENABLED")
        
        ws_thread = threading.Thread(target=self._run_websocket, daemon=True)
        ws_thread.start()
        
        report_thread = threading.Thread(target=self._daily_report_loop, daemon=True)
        report_thread.start()
    
    def stop(self) -> None:
        """Останавливает движок."""
        self.running = False
        if self.ws:
            self.ws.close()
        log("Live Trading Engine stopped", "STOP")
    
    def _run_websocket(self) -> None:
        """WebSocket цикл."""
        while self.running:
            try:
                self.ws = websocket.WebSocketApp(
                    self.ws_url,
                    on_message=self._on_message,
                    on_error=self._on_error,
                    on_close=self._on_close,
                    on_open=self._on_open
                )
                self.ws.run_forever(ping_interval=30, ping_timeout=10)
            except Exception as e:
                log(f"WebSocket error: {e}", "ERROR")
                time.sleep(5)
    
    def _on_open(self, ws) -> None:
        log("WebSocket connected", "WS")
    
    def _on_message(self, ws, message: str) -> None:
        """Обработка сообщений от Binance."""
        try:
            data = json.loads(message)
            if "k" not in data:
                return
            
            k = data["k"]
            candle = {
                "timestamp": pd.to_datetime(k["t"], unit="ms", utc=True),
                "open": float(k["o"]),
                "high": float(k["h"]),
                "low": float(k["l"]),
                "close": float(k["c"]),
                "volume": float(k["v"]),
                "is_closed": k["x"]
            }
            
            self.candle_buffer.append(candle)
            current_price = candle["close"]
            
            self.broker.check_positions(current_price)
            
            if candle["is_closed"] and len(self.candle_buffer) >= 50:
                self.candle_count += 1
                self._process_closed_candle(candle)
        
        except Exception as e:
            log(f"Message processing error: {e}", "ERROR")
            traceback.print_exc()
    
    def _process_closed_candle(self, candle: Dict) -> None:
        """Обрабатывает закрытую свечу с полным анализом."""
        
        df = pd.DataFrame(list(self.candle_buffer))
        df = df[["timestamp", "open", "high", "low", "close", "volume"]]
        df = df.set_index("timestamp")
        
        patterns = detect_all_patterns(df)
        self.last_patterns = patterns
        
        sentiment = calculate_market_sentiment(df)
        market_structure = get_market_structure(df)
        
        current_price = candle['close']
        signal_analysis = analyze_nested_signals(patterns, current_price)
        
        analysis_data = {
            "timestamp": int(candle['timestamp'].timestamp() * 1000),
            "open": candle['open'],
            "high": candle['high'],
            "low": candle['low'],
            "close": candle['close'],
            "volume": candle['volume'],
            "patterns": [p['name'] for p in patterns],
            "sentiment": sentiment['sentiment'],
            "confidence": signal_analysis['total_confidence'],
            "market_structure": market_structure
        }
        save_candle_analysis(analysis_data)
        
        if SEND_CANDLE_REPORT:
            report = generate_candle_report(candle, patterns, sentiment, signal_analysis, market_structure)
            telegram.send(report)
            log(f"Candle #{self.candle_count} analyzed - Patterns: {len(patterns)}, Confidence: {signal_analysis['total_confidence']}%", "CANDLE")
        
        self._check_entry_conditions(signal_analysis, current_price)
    
    def _check_entry_conditions(self, signal_analysis: Dict, current_price: float) -> None:
        """Проверяет условия для входа в позицию."""
        
        if len(self.broker.positions) > 0:
            log(f"Signal detected but position already open", "SKIP")
            return
        
        if signal_analysis['total_confidence'] < MIN_SIGNAL_CONFIDENCE:
            log(f"Signal confidence {signal_analysis['total_confidence']}% below minimum {MIN_SIGNAL_CONFIDENCE}%", "SKIP")
            return
        
        if not signal_analysis['main_signal']:
            return
        
        main_pattern = signal_analysis['main_signal']
        pattern_name = main_pattern['name']
        
        cfg = PATTERN_CONFIG.get(pattern_name, {})
        tp_pct = cfg.get("tp", 0.5)
        sl_pct = cfg.get("sl", 0.25)
        scale = cfg.get("scale", 0.5)
        
        side = signal_analysis['signal_direction']
        
        if side == "LONG":
            tp_price = current_price * (1 + tp_pct / 100)
            sl_price = current_price * (1 - sl_pct / 100)
        else:
            tp_price = current_price * (1 - tp_pct / 100)
            sl_price = current_price * (1 + sl_pct / 100)
        
        confidence_multiplier = 1 + (signal_analysis['total_confidence'] - 60) / 100
        size_usd = BASE_POSITION_USD * (1 + scale) * confidence_multiplier
        size_usd = min(size_usd, BASE_POSITION_USD * 3)
        
        self.broker.open_position(
            pattern=pattern_name,
            side=side,
            entry_price=current_price,
            tp_price=tp_price,
            sl_price=sl_price,
            size_usd=size_usd,
            leverage=DEFAULT_LEVERAGE,
            confidence=signal_analysis['total_confidence'],
            nested_signals=signal_analysis['nested_signals']
        )
    
    def _on_error(self, ws, error) -> None:
        log(f"WebSocket error: {error}", "ERROR")
    
    def _on_close(self, ws, close_status_code, close_msg) -> None:
        log("WebSocket closed", "WS")
    
    def _daily_report_loop(self) -> None:
        """Цикл ежедневных отчётов."""
        while self.running:
            now = datetime.now(timezone.utc)
            if now.hour == DAILY_REPORT_HOUR and now.date() != self.last_report_date:
                self._send_daily_report()
                self.last_report_date = now.date()
            time.sleep(60)
    
    def _send_daily_report(self) -> None:
        """Отправляет дневной отчёт."""
        stats = self.broker.get_stats()
        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        
        save_daily_stats({
            "date": date_str,
            "total_trades": stats["total_trades"],
            "wins": stats["wins"],
            "losses": stats["losses"],
            "total_pnl": stats["total_pnl"],
            "capital": stats["capital"]
        })
        
        winrate = (stats["wins"] / stats["total_trades"] * 100) if stats["total_trades"] > 0 else 0
        
        msg = "═" * 30 + "\n"
        msg += f"📊 DAILY REPORT - {date_str}\n"
        msg += "═" * 30 + "\n\n"
        msg += f"💰 Capital: ${stats['capital']:.2f}\n"
        msg += f"📈 Total Trades: {stats['total_trades']}\n"
        msg += f"✅ Wins: {stats['wins']} | ❌ Losses: {stats['losses']}\n"
        msg += f"🎯 Win Rate: {winrate:.1f}%\n"
        msg += f"💵 Total PNL: ${stats['total_pnl']:+.2f}\n"
        msg += f"📊 Open Positions: {stats['open_positions']}\n"
        msg += f"🕯️ Candles Analyzed: {self.candle_count}\n\n"
        msg += "═" * 30
        
        log(f"Daily Report: Capital ${stats['capital']:.2f}, PNL ${stats['total_pnl']:.2f}, WR {winrate:.1f}%", "REPORT")
        telegram.send(msg)

