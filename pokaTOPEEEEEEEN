def save_position(pos: Dict) -> None:
    """Сохраняет открытую позицию в БД."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""
        INSERT INTO positions (open_time, pattern, side, entry_price, size_usd, leverage, 
                               tp_price, sl_price, status, confidence, nested_signals)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (pos["open_time"], pos["pattern"], pos["side"], pos["entry_price"], 
          pos["size_usd"], pos["leverage"], pos["tp_price"], pos["sl_price"], 
          "OPEN", pos.get("confidence", 0), json.dumps(pos.get("nested_signals", []))))
    conn.commit()
    pos["db_id"] = c.lastrowid
    conn.close()

