def init_database() -> None:
    """Создаёт (если не существует) SQLite-базу с таблицами positions, daily_stats и pattern_stats."""
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS positions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            open_time INTEGER,
            pattern TEXT,
            side TEXT,
            entry_price REAL,
            size_usd REAL,
            leverage INTEGER,
            tp_price REAL,
            sl_price REAL,
            status TEXT,
