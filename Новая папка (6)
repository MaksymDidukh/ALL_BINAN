        return {"sentiment": "UNKNOWN", "strength": 0, "description": "Not enough data",
                "bullish_candles": 0, "bearish_candles": 0, "volatility": 0,
                "price_vs_ema9": "unknown", "price_vs_ema21": "unknown"}

    recent = df.iloc[-20:]

    bullish_candles = (recent['close'] > recent['open']).sum()
    bearish_candles = (recent['close'] < recent['open']).sum()

    ema_short = df['close'].ewm(span=9, adjust=False).mean().iloc[-1]
    ema_long = df['close'].ewm(span=21, adjust=False).mean().iloc[-1]
    current_price = df['close'].iloc[-1]

    volatility = (df['high'].iloc[-20:] - df['low'].iloc[-20:]).mean() / df['close'].iloc[-20:].mean() * 100

    if bullish_candles > bearish_candles * 1.5 and current_price > ema_short > ema_long:
        sentiment = "BULLISH"
        strength = min(100, int((bullish_candles / 20) * 100))
        description = "Strong uptrend"
    elif bearish_candles > bullish_candles * 1.5 and current_price < ema_short < ema_long:
        sentiment = "BEARISH"
        strength = min(100, int((bearish_candles / 20) * 100))
        description = "Strong downtrend"
    elif abs(bullish_candles - bearish_candles) <= 3:
        sentiment = "NEUTRAL"
        strength = 50
        description = "Sideways consolidation"
    else:
        sentiment = "UNCERTAIN"
        strength = 60
        description = "Weak trend or reversal"

    return {
        "sentiment": sentiment,
        "strength": strength,
        "description": description,
        "bullish_candles": int(bullish_candles),
        "bearish_candles": int(bearish_candles),
        "volatility": round(float(volatility), 2),
        "price_vs_ema9": "above" if current_price > ema_short else "below",
        "price_vs_ema21": "above" if current_price > ema_long else "below"
    }


# ========================= PATTERN TESTING =========================
class PatternTester:
    """
    Класс для принудительной генерации паттернов в тестовом режиме.
    Гарантирует, что каждый паттерн сработает хотя бы раз в день.
    """

    def __init__(self):
        self.enabled = ENABLE_PATTERN_TESTING
        self.last_test_time = {}
        self.daily_pattern_usage = {}
        self.lock = threading.Lock()

    def reset_daily_stats(self) -> None:
        """Сбрасывает статистику использования паттернов."""
        with self.lock:
            self.daily_pattern_usage = {pattern: 0 for pattern in PATTERN_CONFIG.keys()}
            log("Pattern testing stats reset for new day", "TEST")

    def get_patterns_needing_testing(self) -> List[str]:
        """
        Возвращает список паттернов, которые ещё не были протестированы сегодня.

        Returns:
            Список названий паттернов.
        """
        with self.lock:
            return [
                pattern for pattern, count in self.daily_pattern_usage.items()
                if count < MIN_PATTERNS_PER_DAY
            ]

    def should_inject_pattern(self) -> Optional[str]:
        """
        Определяет, нужно ли принудительно сгенерировать паттерн.

        Returns:
            Название паттерна или None.
        """
        if not self.enabled:
            return None

        current_time = time.time()
        patterns_needed = self.get_patterns_needing_testing()

        if not patterns_needed:
            return None

        # Выбираем случайный паттерн из недостающих
        pattern = random.choice(patterns_needed)

        # Проверяем, прошло ли достаточно времени с последнего теста
        if pattern in self.last_test_time:
            if current_time - self.last_test_time[pattern] < PATTERN_TEST_INTERVAL:
                return None

        self.last_test_time[pattern] = current_time
        return pattern

    def mark_pattern_used(self, pattern: str) -> None:
        """
        Отмечает использование паттерна.

        Args:
            pattern: Название паттерна.
        """
        with self.lock:
            if pattern not in self.daily_pattern_usage:
                self.daily_pattern_usage[pattern] = 0
            self.daily_pattern_usage[pattern] += 1

    def get_stats(self) -> Dict[str, int]:
        """Возвращает статистику использования паттернов за день."""
        with self.lock:
            return self.daily_pattern_usage.copy()


# ========================= DEMO BROKER =========================
class DemoBroker:
    """
    Демо-брокер — эмулирует торговлю без реального исполнения ордеров.
    Управляет капиталом, позициями и расчётом PnL.
    """

    def __init__(self):
        self.capital = INITIAL_CAPITAL
        self.positions: List[Dict] = []
        self.closed_positions: List[Dict] = []
        self.lock = threading.Lock()

    def open_position(self, pattern: str, side: str, entry_price: float,
                      tp_price: float, sl_price: float, size_usd: float, 
                      leverage: int, is_test_pattern: bool = False) -> None:
        """
        Открывает демо-позицию и сохраняет её в БД.
        Поддерживает множественные позиции.
        """
        with self.lock:
            # Проверяем количество открытых позиций
            if len(self.positions) >= MAX_OPEN_POSITIONS:
                log(f"Max positions limit reached ({MAX_OPEN_POSITIONS}), skipping {pattern}", "SKIP")
                return
            
            # Проверяем направление позиций
            existing_longs = [p for p in self.positions if p["side"] == "LONG"]
            existing_shorts = [p for p in self.positions if p["side"] == "SHORT"]
            
            if side == "LONG":
                if existing_longs and not ALLOW_SAME_DIRECTION:
                    log(f"LONG position already open, same direction disabled", "SKIP")
                    return
                if existing_shorts and not ALLOW_OPPOSITE_DIRECTION:
                    log(f"SHORT position open, opposite direction disabled", "SKIP")
                    return
            else:  # SHORT
                if existing_shorts and not ALLOW_SAME_DIRECTION:
                    log(f"SHORT position already open, same direction disabled", "SKIP")
                    return
                if existing_longs and not ALLOW_OPPOSITE_DIRECTION:
                    log(f"LONG position open, opposite direction disabled", "SKIP")
                    return
            
            pos = {
                "open_time": int(time.time() * 1000),
                "pattern": pattern,
                "side": side,
                "entry_price": entry_price,
                "size_usd": size_usd,
                "leverage": leverage,
                "tp_price": tp_price,
                "sl_price": sl_price,
                "qty": (size_usd * leverage) / entry_price,
                "is_test_pattern": 1 if is_test_pattern else 0
            }
            save_position(pos)
            self.positions.append(pos)
            
            test_label = " [TEST]" if is_test_pattern else ""
            position_count = len(self.positions)
            log(f"POSITION OPENED{test_label} ({position_count}/{MAX_OPEN_POSITIONS}): {side} {pattern} @ {entry_price:.2f} | TP: {tp_price:.2f} | SL: {sl_price:.2f}", "TRADE")

            emoji = "🧪" if is_test_pattern else "🔔"
            msg = f"<b>{emoji} NEW POSITION #{position_count}{test_label}</b>\n\n"
            msg += f"📊 Pattern: {pattern}\n"
            msg += f"{'📈' if side == 'LONG' else '📉'} Side: {side}\n"
            msg += f"💰 Entry: ${entry_price:.2f}\n"
            msg += f"🎯 TP: ${tp_price:.2f}\n"
            msg += f"🛑 SL: ${sl_price:.2f}\n"
            msg += f"💵 Size: ${size_usd:.2f} x{leverage}\n"
            msg += f"📊 Open Positions: {position_count}/{MAX_OPEN_POSITIONS}"
            telegram.send(msg)

    def check_positions(self, current_price: float) -> None:
        """Проверяет все открытые позиции на достижение TP/SL с трейлинг-стопом."""
        with self.lock:
            for pos in self.positions[:]:
                # Инициализируем максимальную прибыль для трейлинга
                if "max_profit_price" not in pos:
                    pos["max_profit_price"] = current_price
                
                # Расчёт текущей прибыли/убытка в процентах
                if pos["side"] == "LONG":
                    profit_pct = ((current_price - pos["entry_price"]) / pos["entry_price"]) * 100
                    # Обновляем максимальную цену для трейлинга
                    if current_price > pos["max_profit_price"]:
                        pos["max_profit_price"] = current_price
                    # Трейлинг стоп: если цена упала на 0.1% от максимума и прибыль > 0.1%
                    trailing_drop = ((pos["max_profit_price"] - current_price) / pos["max_profit_price"]) * 100
                    if profit_pct > 0.1 and trailing_drop > 0.1:
                        # Закрываем по трейлингу
                        close_price = current_price
                        pnl = self._calculate_pnl(pos, close_price)
                        close_time = int(time.time() * 1000)
                        close_position(pos["db_id"], close_time, close_price, pnl)
                        self.capital += pnl
                        self.positions.remove(pos)
                        self.closed_positions.append({**pos, "close_price": close_price, "pnl": pnl})
                        log(f"POSITION CLOSED: 🎯 TRAILING STOP {pos['pattern']} @ {close_price:.2f} | PNL: {pnl:.2f}", "TRADE")
                        msg = f"<b>🎯 TRAILING STOP HIT</b>\n\n"
                        msg += f"📊 Pattern: {pos['pattern']}\n"
                        msg += f"Side: {pos['side']}\n"
                        msg += f"Entry: ${pos['entry_price']:.2f}\n"
                        msg += f"Exit: ${close_price:.2f}\n"
                        msg += f"{'💰' if pnl > 0 else '💸'} PNL: ${pnl:.2f}\n"
                        msg += f"💵 Capital: ${self.capital:.2f}"
                        telegram.send(msg)
                        continue
                else:  # SHORT
                    profit_pct = ((pos["entry_price"] - current_price) / pos["entry_price"]) * 100
                    # Обновляем минимальную цену для трейлинга
                    if current_price < pos["max_profit_price"]:
                        pos["max_profit_price"] = current_price
                    # Трейлинг стоп: если цена выросла на 0.1% от минимума и прибыль > 0.1%
                    trailing_rise = ((current_price - pos["max_profit_price"]) / pos["max_profit_price"]) * 100
                    if profit_pct > 0.1 and trailing_rise > 0.1:
                        close_price = current_price
                        pnl = self._calculate_pnl(pos, close_price)
                        close_time = int(time.time() * 1000)
                        close_position(pos["db_id"], close_time, close_price, pnl)
                        self.capital += pnl
                        self.positions.remove(pos)
                        self.closed_positions.append({**pos, "close_price": close_price, "pnl": pnl})
                        log(f"POSITION CLOSED: 🎯 TRAILING STOP {pos['pattern']} @ {close_price:.2f} | PNL: {pnl:.2f}", "TRADE")
                        msg = f"<b>🎯 TRAILING STOP HIT</b>\n\n"
                        msg += f"📊 Pattern: {pos['pattern']}\n"
                        msg += f"Side: {pos['side']}\n"
                        msg += f"Entry: ${pos['entry_price']:.2f}\n"
                        msg += f"Exit: ${close_price:.2f}\n"
                        msg += f"{'💰' if pnl > 0 else '💸'} PNL: ${pnl:.2f}\n"
                        msg += f"💵 Capital: ${self.capital:.2f}"
                        telegram.send(msg)
                        continue

                # Стандартная проверка TP/SL
                hit_tp = (pos["side"] == "LONG" and current_price >= pos["tp_price"]) or \
                         (pos["side"] == "SHORT" and current_price <= pos["tp_price"])
                hit_sl = (pos["side"] == "LONG" and current_price <= pos["sl_price"]) or \
                         (pos["side"] == "SHORT" and current_price >= pos["sl_price"])

                if hit_tp or hit_sl:
                    close_price = pos["tp_price"] if hit_tp else pos["sl_price"]
                    pnl = self._calculate_pnl(pos, close_price)
                    close_time = int(time.time() * 1000)

                    close_position(pos["db_id"], close_time, close_price, pnl)
                    self.capital += pnl
                    self.positions.remove(pos)
                    self.closed_positions.append({**pos, "close_price": close_price, "pnl": pnl})

                    result = "✅ TP HIT" if hit_tp else "❌ SL HIT"
                    test_label = " [TEST]" if pos.get("is_test_pattern") else ""
                    
                    # Подсчёт текущего винрейта
                    total_closed = len(self.closed_positions)
                    wins = sum(1 for p in self.closed_positions if p["pnl"] > 0)
                    current_winrate = (wins / total_closed * 100) if total_closed > 0 else 0
                    
                    log(f"POSITION CLOSED{test_label}: {result} {pos['pattern']} @ {close_price:.2f} | PNL: {pnl:.2f} | WinRate: {current_winrate:.1f}%", "TRADE")

                    msg = f"<b>{result}{test_label}</b>\n\n"
                    msg += f"📊 Pattern: {pos['pattern']}\n"
                    msg += f"Side: {pos['side']}\n"
                    msg += f"Entry: ${pos['entry_price']:.2f}\n"
                    msg += f"Exit: ${close_price:.2f}\n"
                    msg += f"{'💰' if pnl > 0 else '💸'} PNL: ${pnl:.2f}\n"
                    msg += f"💵 Capital: ${self.capital:.2f}\n"
                    msg += f"🎯 Current Win Rate: {current_winrate:.1f}%"
                    telegram.send(msg)

    def _calculate_pnl(self, pos: Dict, close_price: float) -> float:
        """Расчёт PnL с учётом комиссии."""
        if pos["side"] == "LONG":
            price_diff = close_price - pos["entry_price"]
        else:
            price_diff = pos["entry_price"] - close_price

        pnl = price_diff * pos["qty"]
        fee = pos["size_usd"] * pos["leverage"] * FEE_RATE * 2  # Открытие + закрытие
        return pnl - fee

    def get_stats(self) -> Dict[str, Any]:
        """Возвращает текущую статистику торговли."""
        with self.lock:
            total = len(self.closed_positions)
            wins = sum(1 for p in self.closed_positions if p["pnl"] > 0)
            losses = total - wins
            total_pnl = sum(p["pnl"] for p in self.closed_positions)
            winrate = (wins / total * 100) if total > 0 else 0
            avg_win = sum(p["pnl"] for p in self.closed_positions if p["pnl"] > 0) / wins if wins > 0 else 0
            avg_loss = sum(p["pnl"] for p in self.closed_positions if p["pnl"] < 0) / losses if losses > 0 else 0
            
            return {
                "capital": self.capital,
                "total_trades": total,
                "wins": wins,
                "losses": losses,
                "total_pnl": total_pnl,
                "open_positions": len(self.positions),
                "winrate": winrate,
                "avg_win": avg_win,
                "avg_loss": avg_loss,
                "profit_factor": abs(avg_win * wins / (avg_loss * losses)) if losses > 0 and avg_loss != 0 else 0
            }


