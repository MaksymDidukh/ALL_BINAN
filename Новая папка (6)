            close_price REAL,
            pnl REAL,
            is_test_pattern INTEGER DEFAULT 0
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS daily_stats (
            date TEXT PRIMARY KEY,
            total_trades INTEGER,
            wins INTEGER,
