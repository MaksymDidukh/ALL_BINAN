    def get_pattern_test_stats(self) -> str:
        """Возвращает статистику тестирования паттернов."""
        if not ENABLE_PATTERN_TESTING:
            return "Pattern testing is disabled"

        stats = self.pattern_tester.get_stats()
        date_str = datetime.now(timezone.utc).strftime("%Y-%m-%d")

        msg = f"<b>🧪 Pattern Testing Stats - {date_str}</b>\n\n"
        
        if not stats:
            msg += "No patterns tested yet today"
            return msg

        total_tests = sum(stats.values())
        msg += f"Total tests: {total_tests}\n\n"

        for pattern in PATTERN_CONFIG.keys():
            count = stats.get(pattern, 0)
            status = "✅" if count >= MIN_PATTERNS_PER_DAY else "⏳"
            msg += f"{status} {pattern}: {count}x\n"

        patterns_needed = self.pattern_tester.get_patterns_needing_testing()
        if patterns_needed:
            msg += f"\n📋 Patterns pending: {len(patterns_needed)}"

        return msg


