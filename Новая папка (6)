def update_pattern_stats(date: str, pattern: str) -> None:
    """
    Обновляет статистику использования паттернов.

    Args:
        date: Дата в формате YYYY-MM-DD.
        pattern: Название паттерна.
    """
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""
        INSERT INTO pattern_stats (date, pattern, count)
        VALUES (?, ?, 1)
        ON CONFLICT(date, pattern) DO UPDATE SET count = count + 1
    """, (date, pattern))
    conn.commit()
    conn.close()


def get_pattern_stats(date: str) -> Dict[str, int]:
    """
    Получает статистику использования паттернов за день.

    Args:
        date: Дата в формате YYYY-MM-DD.

    Returns:
        Словарь {pattern_name: count}.
    """
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT pattern, count FROM pattern_stats WHERE date = ?", (date,))
    rows = c.fetchall()
    conn.close()
    return {row[0]: row[1] for row in rows}


