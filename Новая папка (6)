def save_position(pos: Dict) -> None:
    """
    Сохраняет открытую позицию в БД и добавляет db_id в словарь позиции.

    Args:
        pos: Словарь с данными позиции.
    """
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""
        INSERT INTO positions (open_time, pattern, side, entry_price, size_usd,
                               leverage, tp_price, sl_price, status, is_test_pattern)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (pos["open_time"], pos["pattern"], pos["side"], pos["entry_price"],
          pos["size_usd"], pos["leverage"], pos["tp_price"], pos["sl_price"], 
          "OPEN", pos.get("is_test_pattern", 0)))
    conn.commit()
    pos["db_id"] = c.lastrowid
    conn.close()


def close_position(db_id: int, close_time: int, close_price: float, pnl: float) -> None:
    """
    Обновляет запись позиции в БД после закрытия.

    Args:
        db_id: ID записи в таблице positions.
        close_time: Время закрытия (ms timestamp).
        close_price: Цена закрытия.
        pnl: Прибыль/убыток в USD.
    """
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""
        UPDATE positions SET status='CLOSED', close_time=?, close_price=?, pnl=?
        WHERE id=?
    """, (close_time, close_price, pnl, db_id))
    conn.commit()
    conn.close()


